# For an existing local PostgreSQL installation. Replace all placeholders.
DATABASE_URL=postgresql://erp_runtime:CHANGE_ME_RUNTIME@127.0.0.1:5432/erp
MIGRATION_DATABASE_URL=postgresql://erp_owner:CHANGE_ME_OWNER@127.0.0.1:5432/erp
RUNTIME_DB_PASSWORD=CHANGE_ME_RUNTIME_AT_LEAST_20_CHARS
# Docker Compose owner password. Use long URL-safe random values in this reference setup.
POSTGRES_PASSWORD=CHANGE_ME_OWNER_AT_LEAST_20_CHARS
# Development HTTP only. MUST be true behind production TLS.
COOKIE_SECURE=false
SESSION_COOKIE_MODE=strict
# Embedded HTTPS Arena preview: set COOKIE_SECURE=true and SESSION_COOKIE_MODE=partitioned.
# Partitioned mode uses a distinct __Host-erp_preview cookie; sign in again after changing mode.
PORT=3000
# Optional known development seed password; omit to generate one when using npm run seed.
# DEMO_PASSWORD=choose-a-long-development-only-password

# Optional recovery. Without a key/adapter, the reset endpoint explicitly returns unavailable.
# Generate key separately: openssl rand -hex 32. Keep it out of source and audit logs.
# RESET_ENCRYPTION_KEY=<64 hex characters>
# AUTH_MAIL_MODE=file
# PUBLIC_WEB_ORIGIN=http://localhost:5173
# SMTP mode (required instead of file in NODE_ENV=production):
# AUTH_MAIL_MODE=smtp
# SMTP_URL=smtps://encoded-user:encoded-password@trusted-mail-provider:465
# SMTP_FROM=Your business <no-reply@your-verified-domain.example>
# Optional separately provisioned restricted worker role; fallback is DATABASE_URL.
# AUTH_WORKER_DATABASE_URL=postgresql://auth_worker:CHANGE_ME@127.0.0.1:5432/erp
# Never trust forwarded-IP headers until your exact ingress/proxy boundary is configured.

# Optional cookie-independent sandbox sessions. NEVER enable in production.
# Token is JavaScript-readable in tab memory only; refresh requires sign-in.
ENABLE_PREVIEW_MEMORY_SESSION=false

# Host-only diagnostic binding for Docker web container; choose an unused local port.
ERP_WEB_BIND_PORT=8080
# Unique Docker Compose project name avoids naming/volume collisions with other apps.
COMPOSE_PROJECT_NAME=karibu-erp

# Dedicated worker, health and operator-only backup configuration (never expose to browser).
# AUTH_WORKER_DB_PASSWORD=<URL-safe password >=20 chars>
# AUTH_WORKER_DATABASE_URL=postgresql://erp_auth_worker:REPLACE@127.0.0.1:5432/erp
REQUIRE_AUTH_WORKER=false
REQUIRE_FILE_STORAGE=false
# FILE_STORAGE_ROOT=/var/lib/erp/files
LOG_HTTP_REQUESTS=false
# BACKUP_ENCRYPTION_KEY=<64 hex characters; separate from reset encryption key>
# BACKUP_DIRECTORY=/var/backups/erp
# BACKUP_DATABASE_URL=<operator/backup connection; never used by API>
# ERP_RELEASE=<immutable reviewed release identifier>
# TUNNEL_TOKEN=<Cloudflare secret; production compose tunnel profile only>
# API_INTERNAL_URL=http://127.0.0.1:3000  # server-only Next build configuration
NEXT_TELEMETRY_DISABLED=1
